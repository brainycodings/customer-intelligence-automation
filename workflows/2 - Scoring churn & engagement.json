      "id": "76b96427-6834-4e3c-9753-b80e79d6d1ef",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const p = item.json.properties || {};\n\n  // Récupère la valeur d'une propriété HubSpot\n  const get = (key) => p[key]?.value ?? null;\n\n  // Récupère l'email depuis identity-profiles\n  const identities = item.json['identity-profiles']?.[0]?.identities || [];\n  const emailObj = identities.find(i => i.type === 'EMAIL');\n  const email = emailObj?.value || '';\n\n  const inactive = parseInt(get('days_inactive')) || 0;\n  const actions  = parseInt(get('actions_7d'))    || 0;\n  const plan     = get('plan') || 'free';\n  const tickets  = parseInt(get('support_tickets_30d')) || 0;\n\n  let score = 50;\n\n  if (inactive > 20) score -= 40;\n  else if (inactive > 7) score -= 20;\n  else score += 30;\n\n  if (actions === 0) score -= 20;\n  else if (actions >= 10) score += 20;\n  else score += 5;\n\n  if (plan === 'pro' || plan === 'enterprise') score += 15;\n  if (tickets >= 3) score -= 15;\n\n  score = Math.max(0, Math.min(100, score));\n\n  let segment = 'healthy';\n  if (score < 40) segment = 'churn_risk';\n  else if (score <= 70) segment = 'at_risk';\n\n  return { json: {\n    hs_object_id: item.json['canonical-vid'],\n    email: email,\n    engagement_score: score,\n    churn_segment: segment\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
