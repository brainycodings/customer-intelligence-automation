    {
      "parameters": {
        "jsCode": "const get = (item, key) =>\n  item.json.properties?.[key]?.value ?? '';\n\nlet churn = 0, atRisk = 0, healthy = 0;\nlet totalScore = 0, mrrTotal = 0, mrrAtRisk = 0;\n\nfor (const item of items) {\n  const segment = get(item, 'churn_segment');\n  const score   = parseInt(get(item, 'engagement_score')) || 0;\n  const mrr     = parseInt(get(item, 'mrr')) || 0;\n\n  if (segment === 'churn_risk') { churn++; mrrAtRisk += mrr; }\n  else if (segment === 'at_risk') atRisk++;\n  else healthy++;\n\n  totalScore += score;\n  mrrTotal   += mrr;\n}\n\nconst total = items.length;\nconst scoreMoyen = total > 0\n  ? Math.round(totalScore / total)\n  : 0;\n\nconst today = new Date().toISOString().split('T')[0];\n\nreturn [{ json: {\n  date_rapport:    today,\n  total_contacts:  total,\n  churn_risk:      churn,\n  at_risk:         atRisk,\n  healthy:         healthy,\n  score_moyen:     scoreMoyen,\n  mrr_total:       mrrTotal,\n  mrr_at_risk:     mrrAtRisk\n}}];"
      },
